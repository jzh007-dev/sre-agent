# Copy to .env and fill in one provider to start. L3-smoke needs exactly one;
# the second family is only needed for the eval judge and the L3 reviewer (W6).
#
# Primary provider — carries all prompt tuning and the eval baseline.
# One of these is enough (OpenAICompatAdapter covers all three via base_url):
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=

# Different family — required by EVAL.md (judge must differ from the agent) and
# SECURITY.md L3 (reviewer must be a different family). Routing validates this at
# wiring time, so a config pointing the judge at the agent's family fails to start.
ANTHROPIC_API_KEY=

# Optional: Langfuse tracing (wired W2 L8).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
